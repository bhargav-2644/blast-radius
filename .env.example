# FalkorDB connection (local docker compose defaults)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
GRAPH_NAME=blast_radius

# Claude API
ANTHROPIC_API_KEY=

# GitHub token for opening issues (only used after human approval)
GITHUB_TOKEN=

# Claude model used by the agent (D-020)
CLAUDE_MODEL=claude-sonnet-5-5
